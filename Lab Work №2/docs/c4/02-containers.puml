@startuml
!include <C4/C4_Container>
UpdateRelStyle("#334155", "#58697C")
skinparam dpi 132
title Система анализа интерфейсов • Контейнеры (C4 L2)
skinparam nodesep 30
Person(user, "Пользователь анализа", "Дизайнер, владелец интерфейса\nили исследователь")
Person(researcher, "Исследователь-разработчик", "SH-03. Готовит данные, модели и правила")
System_Boundary(system, "Система анализа интерфейсов") {
  Container(web, "Веб-интерфейс", "SPA / React", "Загрузка скриншота и просмотр отчёта")
  Container(backend, "Бэкенд", "API / FastAPI", "Сессии, очередь задач и рекомендации")
  Container(ml, "ML-сервис", "API / FastAPI, PyTorch", "Рамки, карта внимания и оценки действий")
  ContainerDb(db, "База анализов и правил", "База данных / PostgreSQL", "Задачи, привязки, отчёты и версии")
  ContainerDb(archive, "Архив моделей и данных", "Файловое хранилище / Docker volume", "Версии датасетов, моделей и протоколов")
  Container(train, "Подготовка моделей", "CLI / Python, PyTorch", "Обучение, итоговая оценка и проверка правил")
}
Rel_R(web, backend, "Подаёт задачу и описания,\nподтверждает рамку,\nчитает статус и отчёт", "HTTPS/REST")
Rel_R(backend, ml, "Передаёт изображение, тип,\nID запроса и выпуска", "HTTP/REST")
Rel_D(backend, db, "Пишет задачи и отчёты,\nчитает выпуск и правила", "SQL/TCP")
Rel_D(ml, archive, "Читает выпуск", "ФС, чтение")
Rel_U(train, db, "Публикует выпуски моделей\nи версии правил", "SQL/TCP")
Rel_U(train, archive, "Читает наборы, сохраняет\nвеса и протоколы", "ФС, чтение и запись")
Rel_D(user, web, "Запускает анализ,\nпросматривает отчёт", "HTTPS")
Rel_U(researcher, train, "Готовит выпуск и правила", "CLI")
@enduml
