@startdot
digraph UC {
  graph [layout=neato, inputscale=72, splines=line, overlap=true, outputorder=edgesfirst,
         bgcolor="white", pad=0.18, fontname="DejaVu Sans", dpi=120]
  node [pin=true, fontname="DejaVu Sans", fontcolor="#17324A", fontsize=14]
  edge [fontname="DejaVu Sans", fontsize=12, color="#526A7E", fontcolor="#324C62", arrowsize=0.85, penwidth=1.25]

  // Позиции заданы в пунктах. X растёт вправо, Y в вызовах ниже растёт вниз.
  !procedure $dotPoint($k,$x,$y)
    $k [pos="$x,-$y!", shape=point, width=0, height=0, label="", style=invis]
  !endprocedure

  !procedure $actor($id,$x,$y,$title,$code)
    !$top = $y - 17
    !$neck = $y - 9
    !$hip = $y + 10
    !$foot = $y + 24
    !$left = $x - 15
    !$right = $x + 15
    !$legL = $x - 11
    !$legR = $x + 11
    !$textY = $y + 45
    $id##Head [pos="$x,-$top!", shape=circle, fixedsize=true, width=0.21, height=0.21, label="", color="#31516B", penwidth=1.35]
    $dotPoint($id+"Neck",$x,$neck)
    $dotPoint($id+"Hip",$x,$hip)
    $dotPoint($id+"HandL",$left,$y)
    $dotPoint($id+"HandR",$right,$y)
    $dotPoint($id+"FootL",$legL,$foot)
    $dotPoint($id+"FootR",$legR,$foot)
    $id##Neck -> $id##Hip [dir=none, color="#31516B"]
    $id##HandL -> $id##HandR [dir=none, color="#31516B"]
    $id##Hip -> $id##FootL [dir=none, color="#31516B"]
    $id##Hip -> $id##FootR [dir=none, color="#31516B"]
    $id##Text [pos="$x,-$textY!", shape=plain, label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD WIDTH="210" ALIGN="LEFT">$title</TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#4D6477">$code</FONT></TD></TR></TABLE>>]
  !endprocedure

  // Точка начала связи находится рядом с фигурой актора.
  !procedure $association($actorX,$actorY,$target,$dx,$dy)
    !$x = $actorX + $dx
    !$y = $actorY + $dy
    $dotPoint("FromActor"+$target,$x,$y)
    FromActor##$target -> $target:w [dir=none]
  !endprocedure

  // Центры овалов используются при построении связей и подписей.
  !$rowX = {}
  !$rowY = {}
  !procedure $usecase($n,$x,$y,$action,$fill)
    !global $rowX = %json_add($rowX,"C"+$n,$x)
    !global $rowY = %json_add($rowY,"C"+$n,$y)
    C##$n [pos="$x,-$y!", shape=ellipse, fixedsize=true, width=3.55, height=0.87,
      style=filled, fillcolor="$fill", color="#55738D", penwidth=1.1,
      label="UC-$n [FR-$n]\n$action"]
  !endprocedure

  $actor(D,151,218,"Дизайнер / аналитик","SH-01")
  $actor(O,151,347,"Владелец интерфейса","SH-02 (внешний)")
  $actor(R,151,476,"Исследователь-разработчик","SH-03")
  !$userX = 348
  !$userY = 347
  $actor(U,$userX,$userY,"Пользователь анализа"," ")
  UText [label="Пользователь\nанализа", fontsize=13, pos="321,-286!"]
  // У трёх обобщений есть зазоры у фигурок с обеих сторон.
  $dotPoint(DStart,185,222)
  $dotPoint(OStart,185,347)
  $dotPoint(RStart,185,472)
  $dotPoint(UHigh,318,326)
  $dotPoint(UMiddle,318,347)
  $dotPoint(ULow,318,368)
  DStart -> UHigh [arrowhead=empty]
  OStart -> UMiddle [arrowhead=empty]
  RStart -> ULow [arrowhead=empty]

  // Рамка подсистемы. Координаты закрепляют её размер и положение заголовка.
  Frame [pos="918,-406!", width=13.5, height=10.9, fixedsize=true, shape=box, label="", color="#6B8397", penwidth=1.15]
  FrameTitle [pos="918,-39!", shape=plain, fontsize=17, label=<<B>Подсистема анализа интерфейса</B>>]

  // Слева — действия пользователя. Первые две строки: загрузка и выбор типа.
  $usecase("01",647,85,"Загрузить скриншот","#F6F9FC")
  $usecase("02",647,164,"Указать тип интерфейса","#F6F9FC")
  $usecase("03",647,254,"Запустить анализ","#DCECF8")
  $usecase("11",647,364,"Просмотреть результат","#F6F9FC")
  $usecase("12",647,455,"Выгрузить JSON","#F6F9FC")
  $usecase("13",647,548,"Предоставить сведения\nо функциях","#F6F9FC")
  $usecase("20",647,655,"Подтвердить привязку\nописания к рамке","#DCECF8")

  // Справа — включённые действия и условное сопоставление.
  $usecase("04",1250,88,"Проверить файл","#F6F9FC")
  $usecase("05",1250,168,"Выделить элементы","#F6F9FC")
  $usecase("06",1250,248,"Построить карту внимания","#F6F9FC")
  $usecase("07",1250,328,"Оценить внимание\nпо элементам","#F6F9FC")
  $usecase("08",1250,408,"Оценить аффордансы","#F6F9FC")
  $usecase("09",1250,654,"Выявить потенциальные\nпроблемы","#F6F9FC")
  $usecase("10",1250,495,"Сформировать рекомендации","#F6F9FC")
  $usecase("14",1250,755,"Сопоставить действия\nи сведения о функциях","#F6F9FC")

  $association($userX,$userY,"C01",14,-21)
  $association($userX,$userY,"C02",19,-14)
  $association($userX,$userY,"C03",22,-7)
  $association($userX,$userY,"C11",24,0)
  $association($userX,$userY,"C12",22,7)
  $association($userX,$userY,"C13",19,14)
  $association($userX,$userY,"C20",14,21)

  // Подпись каждого включения перемещается вместе с его исходным и целевым овалами.
  !procedure $mark($key,$x,$y,$value)
    $key [pos="$x,-$y!", shape=box, style=filled, fillcolor=white, color=white,
          penwidth=0, width=0, height=0, margin="0.045,0.025", fontsize=12, fontcolor="#2C4E6A", label="$value"]
  !endprocedure

  // dx, dy — смещение от центра исходного овала до точки на его контуре.
  // percent — положение подписи вдоль промежутка между колонками.
  !procedure $include($source,$target,$dx,$dy,$port,$percent)
    !$sx = %intval($rowX[$source]) + $dx
    !$sy = %intval($rowY[$source]) + $dy
    !$tx = %intval($rowX[$target])
    !$ty = %intval($rowY[$target])
    !$x = $sx + ($tx - 128 - $sx) * $percent / 100
    !if $port == ":w"
      !$tx = $tx - 128
    !endif
    !$y = $sy + ($ty - $sy) * ($x - $sx) / ($tx - $sx)
    !$start = $source+"to"+$target
    $dotPoint($start,$sx,$sy)
    $start -> $target$port [style=dashed, arrowhead=vee, color="#466785"]
    $mark($source+$target+"Label",$x,$y,"«include»")
  !endprocedure

  $include("C03","C04",76,-25,":w",76)
  $include("C03","C05",107,-17,":w",76)
  $include("C03","C06",124,-8,":w",76)
  $include("C03","C07",128,0,":w",76)
  $include("C03","C08",122,9,":w",76)
  $include("C03","C10",101,19,":w",76)
  $include("C03","C09",64,27,"",76)
  $include("C20","C10",112,-15,"",42)
  $include("C20","C09",128,2,"",42)

  !procedure $extend($source,$target,$guard)
    $source:n -> $target:s [style=dashed, arrowhead=vee, color="#466785"]
    !$x = %intval($rowX[$source]) - 90
    !$a = %intval($rowY[$source])
    !$b = %intval($rowY[$target])
    !$y = ($a + $b) / 2
    $mark(Condition,$x,$y,"«extend»\n"+$guard)
  !endprocedure
  $extend("C14","C09","[привязка подтверждена]")
}
@enddot
