@startuml
left to right direction
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 14
skinparam packageStyle rectangle
skinparam usecaseBackgroundColor #EEF4FA
skinparam usecaseBorderColor #355570
skinparam actorBorderColor #355570
actor "Пользователь анализа" as U
actor "Дизайнер / аналитик\nSH-01" as D
actor "Владелец интерфейса\nSH-02 (внешний)" as O
actor "Исследователь-разработчик\nSH-03" as R
D --|> U
O --|> U
R --|> U
rectangle "Система: анализ интерфейса" {
 usecase "UC-01 [FR-01]\nЗагрузить скриншот" as C1
 usecase "UC-02 [FR-02]\nУказать тип интерфейса" as C2
 usecase "UC-03 [FR-03]\nЗапустить анализ" as C3
 usecase "UC-04 [FR-04]\nПроверить файл" as C4
 usecase "UC-05 [FR-05]\nВыделить элементы" as C5
 usecase "UC-06 [FR-06]\nПостроить карту внимания" as C6
 usecase "UC-07 [FR-07]\nОценить внимание по элементам" as C7
 usecase "UC-08 [FR-08]\nОценить аффордансы" as C8
 usecase "UC-09 [FR-09]\nВыявить потенциальные проблемы" as C9
 usecase "UC-10 [FR-10]\nСформировать рекомендации" as C10
 usecase "UC-11 [FR-11]\nПросмотреть результат" as C11
 usecase "UC-12 [FR-12]\nВыгрузить JSON" as C12
 C3 ..> C4 : <<include>>
 C3 ..> C5 : <<include>>
 C3 ..> C6 : <<include>>
 C3 ..> C7 : <<include>>
 C3 ..> C8 : <<include>>
 C3 ..> C9 : <<include>>
 C3 ..> C10 : <<include>>
 usecase "UC-13 [FR-13]\nПредоставить сведения\nо функциях" as C13
 usecase "UC-14 [FR-14]\nСопоставить действия\nи сведения о функциях" as C14
 C14 ..> C9 : <<extend>>\n[есть связанные сведения]
 note right of C14
   Точка расширения UC-09:
   сопоставление перед
   применением правил
 end note
}
U -- C1
U -- C2
U -- C3
U -- C11
U -- C12
U -- C13
@enduml
